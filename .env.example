FLASK_DEBUG=false
# Безпечний дефолт (Волна 0 / T1.1): слухати лише локальну машину. Вихід на
# всю мережу — свідомий opt-in: RECALL_BIND_ALL=1 або FLASK_HOST=0.0.0.0.
# Мережевий bind вимагає явного SECRET_KEY (інакше hard-fail) і, як правило,
# RECALL_LOCAL_TRUSTED=0 + RECALL_API_KEY (див. нижче).
FLASK_HOST=127.0.0.1
FLASK_PORT=5050
APP_ENV=development
SECRET_KEY=change-me-in-production
FORCE_CPU=false
LOG_LEVEL=INFO

# --- Транскрипція ---
# faster (за замовчуванням) — faster-whisper/CTranslate2; openai — legacy fallback.
# WHISPER_BACKEND=faster

# --- Claude API: polish, enrichment (summary/задачі/сутності), RAG-чат, копілот ---
# БЕЗ ключа ці функції просто вимкнені — транскрипція і пошук працюють далі.
# Ключ: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# Дефолтна модель для тексту/RAG (див. app/services/models.py).
# CLAUDE_MODEL=claude-opus-5

# --- Діаризація (розділення спікерів) ---
# pyannote тягнеться з Hugging Face і вимагає ТОКЕН + прийняття ліцензії моделі
# на її сторінці (pyannote/speaker-diarization-3.1 і pyannote/segmentation-3.0).
# Без HF_TOKEN diarization_service.is_available() → False, транскрипція
# зберігається без speaker-полів.
# HF_TOKEN=

# --- Живий ко-пілот дзвінка (Phase 19) ---
# Вимагає Ollama з локальною моделлю; без неї копілот вимкнений, запис працює.
# COPILOT_ENABLED=1
# LOCAL_LLM_URL=http://localhost:11434
# LOCAL_LLM_MODEL=qwen2.5:14b-instruct-q5_K_M
# Моделі Claude для верифікації важливого (звичайна / арбітраж складних кейсів).
# COPILOT_MODEL_API=claude-sonnet-5
# COPILOT_MODEL_API_GNARLY=claude-opus-5

# --- T1.2 (REMEDIATION_PLAN Волна 1): auth-гейт на /api/* (app/core/auth.py) ---
# RECALL_LOCAL_TRUSTED: дефолт "1" (увімкнено). Поки увімкнено, запити з
# localhost (127.0.0.1 / ::1) НЕ потребують ключа — поточний UX без пароля
# на своїй машині зберігається. Вимкніть (RECALL_LOCAL_TRUSTED=0), якщо
# застосунок доступний по мережі (RECALL_BIND_ALL=1 / FLASK_HOST=0.0.0.0)
# і ви хочете вимагати ключ навіть локально.
# RECALL_LOCAL_TRUSTED=1
#
# RECALL_API_KEY: ключ для доступу НЕ з localhost (або коли
# RECALL_LOCAL_TRUSTED=0). Клієнт передає його в заголовку
# X-Recall-Api-Key: <key>  (або Authorization: Bearer <key>).
# Якщо не задано — доступ не з localhost fail-closed (заборонений завжди).
# RECALL_API_KEY=

# --- T1.3 (REMEDIATION_PLAN Волна 1): allowlist коренів для import-folder ---
# RECALL_IMPORT_ROOTS: список абсолютних директорій (роздільник ';'), з яких
# дозволено масовий імпорт документів (POST /api/documents/import-folder).
# Порожньо/не задано → import-folder заборонений звідусіль (deny-by-default;
# захист від читання довільних файлів через мережевий доступ). Приклад:
# RECALL_IMPORT_ROOTS=E:\Docs\ToImport;D:\Shared\Reports

# Лог кожного виклику MCP-тулзи у logs/mcp_calls.log (ім_я, аргументи, мс, ok/err).
RECALL_MCP_DEBUG_LOG=1
#
# RECALL_MCP_KEY: потрібен ЛИШЕ для транспорту http (`mcp_server.py --transport http`),
# який слухає 127.0.0.1:5060 і гейтить запити Bearer-ключем. Дефолтний stdio-транспорт
# (Claude Desktop / Claude Code) ключа не потребує.
# Згенерувати: python -c "import secrets; print(secrets.token_urlsafe(32))"
# RECALL_MCP_KEY=

# --- Telegram: слухач, догонка, покриття (Волни 1-3 роадмапу Telegram) ---
# Ключі акаунта з https://my.telegram.org/apps — БЕЗ них слухач не стартує.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
#
# TELEGRAM_CATCHUP: догрузка того, що прийшло, поки слухач не працював.
# Слухач — дочірній процес app.py, тож вимкнена на ніч машина = дірка в архіві
# (на живих даних 30 втрачених буднів за 8 місяців). 0 — вимкнути догонку.
# TELEGRAM_CATCHUP=1
#
# TELEGRAM_CATCHUP_DEBOUNCE_MIN: не догоняти чат, якщо його вже догоняли менш
# ніж N хвилин тому. app.py під час розробки стартує десятки разів на день.
# TELEGRAM_CATCHUP_DEBOUNCE_MIN=15
#
# TELEGRAM_DIALOG_LIMIT: скільки діалогів перелічувати (/dialogs, /coverage,
# догонка). 200 упиралось у стелю — тоді «чату немає серед діалогів» не
# відрізнити від «не вліз у вікно».
# TELEGRAM_DIALOG_LIMIT=500
#
# TELEGRAM_BACKFILL_DELAY: пауза між повідомленнями при backfill/ремонті/догонці.
# TELEGRAM_BACKFILL_DELAY=0.5

# --- Нитки переписки (Волна 4.5) ---
# Одиниця сенсу в Telegram — нитка всередині чату, не чат і не повідомлення.
#
# TG_THREAD_BURST_GAP_MIN: пауза, після якої розмова вважається новим сплеском.
# 180 хв з заміру розподілу: на 30 хв третина сплесків вироджується в одинаків,
# на 1440 хв у сплеск заходить кілька робочих днів.
# TG_THREAD_BURST_GAP_MIN=180
#
# TG_THREAD_MODEL: модель, яка ділить сплеск на теми. Окремо від LOCAL_LLM_MODEL
# (та обслуговує копілот у реальному часі). Порожньо = взяти LOCAL_LLM_MODEL.
# TG_THREAD_MODEL=qwen2.5:7b-instruct
#
# TG_THREAD_IDLE_DAYS: скільки нитка може мовчати, лишаючись кандидатом на
# продовження. 3, а не більше: на прогоні з вікном 21 день максимальний розрив
# усередині нитки упирався рівно в 21 (медіана 2.8) — межу ставило вікно, а не
# зміст. Модель бере зі списку кандидатів те, що їй показали, тож продовження
# стримує саме вікно.
# TG_THREAD_IDLE_DAYS=3
#
# TG_THREAD_MAX_MSGS: стеля обсягу нитки. Мʼяка: забороняє приймати НОВУ
# розмову, але не рве поточну навпіл (тому фактичний розмір буває більший).
# Без неї ниток зібрали значна частина архіву, найбільша — повідомлень за два місяці.
# TG_THREAD_MAX_MSGS=30
#
# RAG_THREAD_STITCH: скільки сусідів по нитці підшивати до знахідки у промпт.
# Саме це доносить ВІДПОВІДЬ разом із питанням: у переписки відповідь — наступна
# репліка, спільних слів із запитом у неї немає, окремо вона не знаходиться.
# RAG_THREAD_STITCH=6

# --- Досьє чату (Волна 4.5.2) ---
# Профіль перебудовується ЗА ПОРОГОМ, ніколи не на кожне повідомлення.
# TG_CONTEXT_MIN_NEW: скільки нових повідомлень накопичити перед оновленням.
# TG_CONTEXT_MIN_NEW=30
# TG_CONTEXT_MAX_AGE_H: оновити навіть мовчазний чат раз на стільки годин.
# TG_CONTEXT_MAX_AGE_H=24
# TG_CONTEXT_THREADS: скільки останніх ниток показувати моделі (досьє про
# поточний стан справ, а не літопис).
# TG_CONTEXT_THREADS=12
# TG_CONTEXT_MODEL: порожньо = взяти LOCAL_LLM_MODEL.
# УВАГА: 32B на 24GB GPU тут непридатна — заміряно, один чат не вклався і в 300с
# (модель ~20GB не влазить поруч з e5+reranker і йде в CPU), тоді як 7B робить
# той самий чат за 8с. Тримайте тут 7B-клас.
# TG_CONTEXT_MODEL=qwen2.5:7b-instruct
#
# TG_CONTEXT_TIMEOUT: досьє — пакетна задача, дефолтні 60с local_llm тут малі.
# TG_CONTEXT_TIMEOUT=300
#
# TG_CONTEXT_THREAD_SAMPLE: скільки повідомлень нитки давати моделі. Нитка вже
# має назву — вибірка потрібна лише щоб побачити, чим розмова скінчилась.
# TG_CONTEXT_THREAD_SAMPLE=4

# --- Зобовʼязання з переписки (Волна 5.1) ---
# Каскад: локальний триаж відсіює нитки без домовленостей, Claude витягує
# структуру лише з відібраних. Гард Волни 0 (жодного Claude на telegram)
# знімається саме так — вибірково, а не цілком.
#
# TG_TASKS_TRIAGE_MODEL: модель триажу. 7B-клас (див. попередження вище).
# TG_TASKS_TRIAGE_MODEL=qwen2.5:7b-instruct
# TG_TASKS_TRIAGE_TIMEOUT=180
#
# TG_TASKS_TRIAGE_PREVIEW / TG_TASKS_TRIAGE_MAX_MSGS: скільки символів кожного
# повідомлення і скільки повідомлень показувати триажу. Прев'ю, а не суцільний
# текст: найбільша нитка архіву — 337 тис. символів, і це один документ,
# надісланий у чат; обрізання суцільного тексту показало б моделі голову
# документа замість розмови.
# TG_TASKS_TRIAGE_PREVIEW=400
# TG_TASKS_TRIAGE_MAX_MSGS=40
#
# TG_TASKS_MODEL: порожньо = дефолтна Claude-модель архіву.
# TG_TASKS_EFFORT: витяг структури, глибокий thinking не окупається.
# TG_TASKS_EFFORT=low
# TG_TASKS_PREVIEW / TG_TASKS_MAX_CHARS: витягу потрібно більше тексту, ніж
# триажу (у 400 символів строк може не влізти), але не весь документ.
# TG_TASKS_PREVIEW=1500
# TG_TASKS_MAX_CHARS=24000

# --- Питання без відповіді (Волна 5.3) ---
# Хто «я» в переписці. Береться від слухача Telegram (він єдиний тримає сесію)
# і кешується в data/tg_self.local.json. Задавати вручну треба лише якщо
# слухач не використовується — тоді @згадки без ніка не ловляться.
# TELEGRAM_SELF_NAME=Ім'я Прізвище
# TELEGRAM_SELF_USERNAME=nickname
#
# TG_QUESTIONS_WINDOW_H: скільки годин присутності у ТОМУ Ж чаті після питання
# вважати відповіддю. Присутність рахується по чату, а не по нитці: нитки
# розмічені моделлю, і відповідь регулярно лягає в сусідню (заміряно: 4 випадки
# з 10). Свідомо м'який критерій — назвати забутим те, на що людина відповіла,
# гірше, ніж пропустити.
# TG_QUESTIONS_WINDOW_H=24
# TG_QUESTIONS_DAYS=90
