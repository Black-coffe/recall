# Recall — example .env
# GENERATED from app/core/settings.py — do not edit by hand.
# Update: .venv/Scripts/python.exe -m app.core.settings env-example > .env.example

# --- Server ---
# Flask debug mode flag.
# DEBUG=True allows the default SECRET_KEY without a hard-fail; DEBUG=False requires a real key.
FLASK_DEBUG=false
# Safe default (Wave 0/T1.1) — listen only on the local machine.
# A network bind (0.0.0.0) requires an explicit SECRET_KEY, otherwise config.py hard-fails.
FLASK_HOST=127.0.0.1
# Flask server port.
# The port app.py listens on.
FLASK_PORT=5050
# Interface language: auto (by system language) | uk | en.
# auto: system uk → Ukrainian, otherwise English; uk/en — an explicit choice, stronger than auto. Changed in Settings without a restart.
# RECALL_UI_LANG=auto
# Choice of configuration class.
# development|production|testing → DevelopmentConfig|ProductionConfig|TestingConfig.
APP_ENV=development
# Flask session key.
# Default/empty + DEBUG=False → autogen and write to .env; the same + a network bind → hard-fail.
SECRET_KEY=dev-secret-key-change-in-production
# Force CPU for whisper/embeddings/reranker.
# true → the GPU is not used even when CUDA is available.
FORCE_CPU=false
# Application log level.
# Passed to basicConfig/RotatingFileHandler.
LOG_LEVEL=INFO
# desktop — the full application (recorder, SPA shell); headless — API/ingest only.
# headless turns off RECORDING_ENABLED/RECORDING_VIDEO_ENABLED and the SPA shell/sw.js (404 'headless'); any other value → ValueError from profile().
# RECALL_PROFILE=desktop
# text|json — log line format.
# json turns on JsonFormatter on the file+stream handlers in app.py.
# RECALL_LOG_FORMAT=text

# --- Transcription ---
# faster (CTranslate2, default) or openai (legacy fallback).
# Selects the backend in whisper_manager_new.py.
# WHISPER_BACKEND=faster
# Size of the parallel transcription semaphore.
# 1 — faster-whisper is not thread-safe on a shared model handle (whisper_manager_new.py); live streams of recordings and full transcription run one after another.
# WHISPER_MAX_PARALLEL=1
# batch_size for BatchedInferencePipeline on long files (faster backend).
# Affects faster-whisper only.
# WHISPER_BATCH_SIZE=8
# LRU cache of several simultaneously loaded whisper models (e.g. 'small' live + 'medium' full).
# Prevents evict/reload of the model on CUDA between live and full transcription.
# WHISPER_MODEL_CACHE_SIZE=3
# Warm up the whisper model in the background right after the application starts.
# 0 → no warm-up, the first transcription request is cold.
# RECALL_PRELOAD_WHISPER=1
# Which model to warm up.
# Mirrors the default transcription model (large-v3, whisper-best-default).
# RECALL_PRELOAD_WHISPER_MODEL=large-v3
# Vocabulary of "hard" names from the entity graph (app/services/vocabulary.py, K1): off | hotwords | initial_prompt. Default per the K1 measurement: names 15 % → 35 %, +11 % transcription time.
# hotwords/initial_prompt → ≈50 names (≤223 tokens) go to faster-whisper on files, recordings, live transcription and TG voice messages; YouTube never. off — the call as before K1.
# RECALL_VOCAB_MODE=hotwords
# Language detection on every window of up to 30 s of speech (not per phrase) — faster-whisper multilingual. Default per the K1 blind pairs (7 of 10).
# 1 → the language is detected on every window in full transcription, files and TG voice messages, but only when no language is chosen (auto); an explicit language (uk/ru/en) is not overridden (4.8.1). Live transcription and YouTube do not get it.
# WHISPER_MULTILINGUAL=1

# --- Rate limits ---
# Flask-limiter limit for /api/transcribe.
# Flask-limiter format (N/interval).
# RATE_LIMIT_TRANSCRIBE=60/minute
# Limit for YouTube endpoints.
# Flask-limiter format (N/interval).
# RATE_LIMIT_YOUTUBE=30/minute
# Limit for Claude polish requests.
# Flask-limiter format (N/interval).
# RATE_LIMIT_POLISH=20/hour
# Limit on recording starts (Phase 9.10 hardening).
# Each session is ~10MB/min on disk — a low limit prevents script-driven abuse.
# RATE_LIMIT_RECORDING_START=10/minute

# --- Executors ---
# Pool size for latency-critical jobs (recording_finalize).
# Usually one recorder at a time — 1 worker is always free, does not wait for a batch.
# LIVE_EXECUTOR_WORKERS=1
# Pool size for the rest of the jobs (tg_transcribe, video_analysis, etc.).
# These jobs can load the GPU (faster-whisper) — deliberately not increased.
# BATCH_EXECUTOR_WORKERS=2

# --- Auto cleanup ---
# Turns on periodic deletion of old temporary files (Phase 6.3).
# Off by default — so a local user does not lose files by accident.
# AUTO_CLEANUP_ENABLED=false
# Age of files (days) beyond which they are deleted.
# Applies only if AUTO_CLEANUP_ENABLED=true.
# AUTO_CLEANUP_DAYS=7

# --- Recording ---
# Autodetect via the pyaudiowpatch import; '0'/'false' forces it off.
# headless is always False without trying to import pyaudiowpatch (Assumption 3).
# RECORDING_ENABLED=
# Recording session chunk size.
# Raw PCM is written in chunks for crash resilience.
# RECORDING_CHUNK_SECONDS=5
# Recording sample rate.
# WASAPI loopback + mic.
# RECORDING_SAMPLE_RATE=48000
# Number of recording channels.
# Passed to RecordingService.start() as channels — the number of mic+system mixdown tracks.
# RECORDING_CHANNELS=2
# Bitrate of the final MP3 at mixdown.
# Goes to finalize_session() as the encoding bitrate of final.mp3.
# RECORDING_MP3_BITRATE=192k
# Do not delete the intermediate raw PCM after finalization.
# true — takes much more disk.
# RECORDING_KEEP_PCM=False
# Keep the separate mic.wav/system.wav after mixdown into final.mp3.
# Deleted by default — otherwise ~1GB/session of dead space.
# RECORDING_KEEP_WAV=False
# Maximum simultaneous recordings (minimum 1).
# Applies only if RECORDING_ENABLED; one more start over the limit → 409 SESSION_LIMIT (RecordingService(max_active=...)).
# RECORDING_MAX_ACTIVE=2
# Minimum free space (MB) below which recording does not start.
# Below it — recording/screens.py refuses to start a recording with a message about low disk space.
# RECORDING_MIN_DISK_MB=500
# Call prompts (K2, app/services/recording/call_watch.py): "Record?" when an application from the list has both microphone and sound active for 30 s; "Stop?" when the call is over.
# 1 → in the app.py process (under __main__) it looks at audio sessions every second and sends a Windows notification; a recording never starts without a click. 0 → the thread does not start, GET /api/recording/autoprompt returns enabled:false.
# RECORDING_AUTOPROMPT=1
# Seconds after a recording stops before the server saves it itself (recording-autosave).
# If nobody saved, discarded or is editing the stopped recording by then, the server transcribes it, titles it and files it when confident; the save screen counts down to the same moment. 0 → off.
# RECORDING_AUTOSAVE_SEC=60
# Whisper model of the server autosave.
# Only the autosave path; the save screen keeps its own choice.
# RECORDING_AUTOSAVE_MODEL=large-v3
# Language of the server autosave transcription ('auto' = detect).
# The live-preview language is not used: it is a preview choice, and calls are often spoken in another language.
# RECORDING_AUTOSAVE_LANGUAGE=auto
# Minimum k-NN confidence for the autosave to set the direction itself.
# Below it the direction stays empty and the Audio library asks the user.
# RECORDING_AUTOSAVE_MIN_CONFIDENCE=0.6
# Calling applications for K2 prompts: exe names separated by commas (case-insensitive, ".exe" may be omitted).
# Only these applications can trigger "Record?"; dictation tools (VoiceDrop, Wispr Flow) must not be added here — their conversation with the microphone is not a call.
# RECORDING_AUTOPROMPT_APPS=zoom.exe,ms-teams.exe,teams.exe,viber.exe,whatsapp.root.exe,whatsapp.exe,chrome.exe,msedge.exe,firefox.exe,discord.exe,slack.exe,signal.exe
# How many seconds in a row the calling app must have both microphone and sound active (with voice on both sides) before "Record?" appears.
# Less → the prompt comes sooner, but more chance of a false one; works only with RECORDING_AUTOPROMPT.
# RECORDING_AUTOPROMPT_SECONDS=30
# What a detected call does: prompt (show "Record?" and wait for a click) or record (start recording by itself and show "Recording started" with Stop / Keep).
# prompt → nothing starts without a click; record → opt-in auto-record of a confirmed call, a failed start falls back to the prompt; works only with RECORDING_AUTOPROMPT.
# RECORDING_AUTOPROMPT_ACTION=prompt
# Minutes after the first "Record?" before one repeat for a call that is still live and unrecorded.
# One repeat per call, never after "Not needed" or once a recording covers the call; 0 → no repeat.
# RECORDING_AUTOPROMPT_REPROMPT_MIN=10
# Minutes of silence on both tracks after "Stop?" after which the recording stops by itself.
# Applies only to recordings that have already been asked "Stop?"; the recording is kept in full, silence is not counted while paused.
# RECORDING_AUTOSTOP_SILENCE_MIN=10
# Show a recording-consent reminder at every recording start, whatever started it.
# Non-blocking: the recording starts regardless; off hides the reminder only.
# RECORDING_CONSENT_REMINDER=1

# --- Video recording ---
# Phase 22: screen capture (ddagrab → NVENC).
# Turn off if there is no NVIDIA GPU; headless is always False (Assumption 3).
# RECORDING_VIDEO_ENABLED=True
# Path to ffmpeg for the video pipeline.
# If not found at the path — video_probe.ffmpeg_path() raises an error with a hint to install ffmpeg.
# RECORDING_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# Video recording FPS.
# The FPS with which VideoCaptureSupervisor launches ffmpeg screen capture.
# RECORDING_VIDEO_FPS=30
# NVENC codec for video recording.
# The codec passed to VideoCaptureSupervisor — nvenc-specific, requires an NVIDIA GPU.
# RECORDING_VIDEO_CODEC=h264_nvenc
# nvenc -preset.
# Passed as -preset to VideoCaptureSupervisor (nvenc).
# RECORDING_VIDEO_QUALITY=p5
# Constant quality factor of nvenc.
# Passed as -cq to VideoCaptureSupervisor; a lower value means higher quality and a larger file.
# RECORDING_VIDEO_CQ=23
# Maximum simultaneous video tracks (monitors/windows).
# Declared in config.py, but no service reads it — the limit on the number of tracks is effectively not applied.
# RECORDING_VIDEO_MAX_TRACKS=3
# Timeout for waiting for the video process to stop.
# How long to wait for the graceful stop of ffmpeg (proc.wait) in _graceful_stop_proc() before terminate/kill.
# RECORDING_VIDEO_STOP_TIMEOUT_SEC=8
# Build a master MP4 from all tracks after completion.
# true — finalize_video() additionally builds master.mp4; false — only the separate tracks remain.
# RECORDING_BUILD_MASTER_MP4=False
# Show an overlay of the selected capture region.
# false — VideoCaptureSupervisor does not draw the capture region overlay on the screen during recording.
# RECORDING_REGION_OVERLAY=True
# Colour of the capture region overlay.
# Applies only when RECORDING_REGION_OVERLAY=true.
# RECORDING_REGION_OVERLAY_COLOR=#e5484d
# Maximum key frames per video analysis (MAX_FRAMES).
# Above the ceiling the shortest segments are merged with their neighbours (protection against "flickering" video); the result is marked capped. See docs/video-timeline.md.
# RECORDING_VIDEO_ANALYSIS_MAX_FRAMES=1500

# --- Vision ---
# local (Ollama VL, $0/offline, default), claude (Anthropic vision, paid), off.
# Everything degrades: no model/key → the description is empty, frames+OCR work as before.
# VIDEO_VISION_BACKEND=local
# Local Ollama VL model for frame description.
# Applies only when VIDEO_VISION_BACKEND=local — the model that video_vision.py calls via Ollama.
# VIDEO_VISION_MODEL_LOCAL=qwen2.5vl:7b
# Claude vision model (if backend=claude).
# Applies only when VIDEO_VISION_BACKEND=claude — the model that video_vision.py calls via the Anthropic API.
# VIDEO_VISION_MODEL_CLAUDE=claude-haiku-4-5
# Maximum frames per vision description.
# After the ceiling the rest of the session's frames keep an empty vision description (OCR only).
# VIDEO_VISION_MAX_FRAMES=120
# How long Ollama keeps the local vision model in VRAM after a frame.
# The local_llm default is 30 min; 60 s frees ~5 GB a minute after a batch of frames, while 0 would reload the model on every frame (measured 14.10.2026: 5.5–7.6 s/frame versus 2.3–2.5).
# VIDEO_VISION_KEEPALIVE=60s
# Timeout of the vision model call (seconds).
# Timeout of the HTTP call describe_frame() to Ollama/Claude — going over it leaves the frame description empty, best-effort.
# VIDEO_VISION_TIMEOUT=90

# --- Telegram ---
# api_id from https://my.telegram.org/apps.
# Together with TELEGRAM_API_HASH + an installed telethon it turns on TELEGRAM_ENABLED.
# TELEGRAM_API_ID=0
# api_hash from https://my.telegram.org/apps.
# A secret — not in code.
# TELEGRAM_API_HASH=
# Base name of the Telethon session file (the real default is BASE_DIR/telegram, Telethon adds .session).
# The SQLite session file cannot be opened by two clients at the same time.
# TELEGRAM_SESSION=telegram
# Host of the localhost control API of the child listener process.
# On this host telegram_listener.py brings up the control HTTP server; app.py contacts the same address.
# TELEGRAM_CONTROL_HOST=127.0.0.1
# Port of the listener's localhost control API.
# Flask proxies list-dialogs/status/backfill here.
# TELEGRAM_CONTROL_PORT=5051
# Whisper model for voice/audio/video from TG.
# large-v3 — best measured accuracy; large-v3-turbo is ~2.4x faster at slightly lower accuracy.
# TELEGRAM_WHISPER_MODEL=large-v3
# Transcription language of TG media ('auto' — autodetect).
# Passed to the transcription of TG voice/audio in app/blueprints/telegram.py as the language parameter.
# TELEGRAM_WHISPER_LANG=uk
# Catch-up of messages that arrived while the listener was not running.
# 0 turns it off — on live data, 30 lost working days in 8 months without it.
# TELEGRAM_CATCHUP=1
# Do not catch up a chat if it was already caught up less than N minutes ago.
# app.py starts dozens of times a day during development.
# TELEGRAM_CATCHUP_DEBOUNCE_MIN=15
# How many dialogs to list (/dialogs, /coverage, catch-up).
# 200 hit the ceiling — "the chat is not among the dialogs" was indistinguishable from "did not fit the window".
# TELEGRAM_DIALOG_LIMIT=500
# Pause (sec) between messages during backfill/repair/catch-up.
# Delay between messages in telegram_listener.py — prevents FloodWaitError from the Telegram API.
# TELEGRAM_BACKFILL_DELAY=0.5
# The owner's name in the chat (who "I" am).
# Taken from the listener automatically; set manually only if the listener is not used.
# TELEGRAM_SELF_NAME=
# The owner's nickname (without @).
# Needed to catch @mentions without the nickname from the listener session.
# TELEGRAM_SELF_USERNAME=
# Threshold (MB) above which voice/audio originals are deleted after text extraction.
# tg-media-policy-02: owner decision — ONLY originals heavier than the threshold are deleted, small ones stay on disk; applies only if text extraction succeeded.
# TELEGRAM_ORIGINAL_MAX_MB=100

# --- Mail ---
# Poll the connected Gmail accounts in the background.
# Off stops the periodic sync of the enabled labels; accounts and archived mail stay.
# MAIL_POLL_ENABLED=1
# Interval (minutes) between mail polls.
# How often the poller checks the enabled labels for new messages.
# MAIL_POLL_MINUTES=5
# How many months of history a newly enabled label loads.
# Limits the first sync of a label; deeper history is loaded on request.
# MAIL_BACKFILL_MONTHS=12
# Largest attachment (MB) that is ingested as a document.
# Heavier attachments are skipped.
# MAIL_ATTACH_MAX_MB=25

# --- Calendar ---
# Sync the connected ICS calendars in the background.
# Off stops the periodic sync; sources, events and recording bindings stay.
# CALENDAR_SYNC_ENABLED=1
# Interval (minutes) between calendar syncs.
# Published Google/Outlook feeds refresh on the provider side every few minutes to hours.
# CALENDAR_SYNC_MINUTES=15
# Send a pre-meeting card to Telegram (people, their open tasks, recent calls with them).
# Off stops the brief; one card per calendar event, same privacy filter as the other briefs.
# MEETING_BRIEF_ENABLED=1
# Minutes before a calendar event at which its brief card is sent; valid range 1..180.
# Range 1..180 is the contract of the brief reader (wave4-client-calls-02); the registry itself does not validate ranges.
# MEETING_BRIEF_LEAD_MINUTES=15

# --- Telegram threads ---
# Pause (min) after which a conversation counts as a new burst.
# 180 — from a distribution measurement: at 30 min a third of bursts degenerate into singletons, at 1440 min several working days get in.
# TG_THREAD_BURST_GAP_MIN=180
# How many messages at a time to give the model for splitting a burst.
# Together with TG_THREAD_BATCH_CHARS it divides a burst into sub-batches — whichever of the two limits hits first applies.
# TG_THREAD_BATCH_MSGS=25
# Character ceiling per sub-batch of burst splitting.
# Without slicing, long bursts (up to 338k characters) do not fit in the model context.
# TG_THREAD_BATCH_CHARS=6000
# How many open chat threads to show the model as continuation candidates.
# Default limit in open_threads() (tg_threads.py) — how many candidates the splitting model sees.
# TG_THREAD_CANDIDATES=5
# Model for splitting bursts into threads. Empty = take LOCAL_LLM_MODEL.
# 7B gave the same split as 32B in a quarter of the time.
# TG_THREAD_MODEL=
# How many days without new messages a thread stays a continuation candidate.
# 3, not 21 — in a run with a 21-day window the maximum gap hit exactly the window edge, not the content.
# TG_THREAD_IDLE_DAYS=3
# Soft ceiling of thread volume (forbids a NEW conversation, does not break the current one).
# Without it a few threads collected a large share of the archive, the largest — messages over two months.
# TG_THREAD_MAX_MSGS=30

# --- Thread summaries ---
# Preview of one message (characters) in the thread summary prompt.
# Truncates every message that summaries.py puts into the prompt: the preview shows the shape of the conversation, solid text would show only the start of one attached document.
# TG_SUMMARY_PREVIEW=800
# Character ceiling of the whole thread summary prompt.
# _thread_messages() stops collecting messages as soon as the sum of previews reaches this limit.
# TG_SUMMARY_MAX_CHARS=20000
# How many thread messages to give the model at most.
# Default limit in _thread_messages() (summaries.py) — the second limit of the same pair with TG_SUMMARY_MAX_CHARS, whichever of the two hits first.
# TG_SUMMARY_MAX_MSGS=200
# Model for thread summaries. Empty = the project's default model.
# Empty — summaries.py takes models.get_default_model().
# TG_SUMMARY_MODEL=

# --- Chat dossier ---
# How many new messages to accumulate before rebuilding the chat profile.
# Rebuilding the dossier in tg_chat_context.py does not start until this many new messages accumulate (or TG_CONTEXT_MAX_AGE_H passes).
# TG_CONTEXT_MIN_NEW=30
# Refresh even a silent chat once per this many hours.
# The second threshold of the same pair with TG_CONTEXT_MIN_NEW — fires even without new messages.
# TG_CONTEXT_MAX_AGE_H=24
# How many latest threads to show the model when building the dossier.
# A dossier about the current state of affairs, not a chronicle.
# TG_CONTEXT_THREADS=12
# How many thread messages to give the model for analysis.
# LIMIT in the SQL query that samples thread messages for building the dossier (tg_chat_context.py).
# TG_CONTEXT_THREAD_SAMPLE=4
# Model for building the chat dossier. Empty = take LOCAL_LLM_MODEL.
# 32B on a 24GB GPU is unsuitable for this task — measured, one chat did not finish even in 300s.
# TG_CONTEXT_MODEL=
# Dossier building timeout (sec).
# A batch task, the default 60s of local_llm is too small here.
# TG_CONTEXT_TIMEOUT=300

# --- Commitments from chat ---
# Local model for filtering out threads without agreements.
# 7B class: triage is a yes/no decision, the cheapest task of the cascade.
# TG_TASKS_TRIAGE_MODEL=qwen2.5:7b-instruct
# Timeout of the triage call.
# Passed to the local_llm triage call (max_tokens=200) in tg_tasks.py.
# TG_TASKS_TRIAGE_TIMEOUT=180
# Message preview characters for triage.
# The character ceiling of _preview() for each message that goes into the triage prompt.
# TG_TASKS_TRIAGE_PREVIEW=400
# How many thread messages to show triage.
# Default limit in thread_messages() — how many latest messages both triage and the structured extraction see.
# TG_TASKS_TRIAGE_MAX_MSGS=40
# Claude model for structure extraction. Empty = the archive's default model (CLAUDE_MODEL/DEFAULT_MODEL).
# Empty — tg_tasks.py takes the archive's default model, not a separate one.
# TG_TASKS_MODEL=
# Effort for the Claude extraction of commitment structure.
# Structure extraction — deep thinking does not pay off.
# TG_TASKS_EFFORT=low
# Message preview characters for extraction (more than in triage).
# The character ceiling of _preview() for a message in the structured extraction of commitments (not triage).
# TG_TASKS_PREVIEW=1500
# Thread character ceiling for structure extraction.
# Accumulating thread messages in tg_tasks.py stops as soon as the total length exceeds this ceiling.
# TG_TASKS_MAX_CHARS=24000

# --- Task proposals ---
# Minimum model confidence (0..1) for an extracted task to be proposed to the owner.
# task_proposals.filter_candidates drops a candidate whose confidence is below this; a missing confidence is kept. Dropped candidates are not stored, so lowering it needs a re-run.
# TASK_PROPOSAL_MIN_CONFIDENCE=0.6

# --- Unanswered questions ---
# Hours of presence in the chat after a question for it to count as seen.
# Default REPLY_WINDOW_H in tg_questions.py — the window in which a reply/reaction to the question is looked for.
# TG_QUESTIONS_WINDOW_H=24
# Window (days) for searching unanswered questions.
# Wider than the task digest (30 days) — an unanswered question sometimes hangs for months.
# TG_QUESTIONS_DAYS=90

# --- Entity graph ---
# Switch of the morphological name matcher (cases/abbreviations).
# Off by default — the merge does not change system behaviour without a conscious switch-on.
# TG_ENTITIES_MORPH_ENABLED=0
# TTL (sec) of the entity name dictionary cache.
# load_names — 6200 rows per message; a short TTL so a new entity is caught without a restart.
# TG_ENTITIES_NAMES_TTL=300

# --- RAG retrieval ---
# How many chunks /api/memory/ask returns by default.
# Default of the k parameter in /api/memory/ask when the client did not pass its own.
# RAG_TOP_K=12
# Weight of the recency boost on top of the RRF score.
# Moderate on purpose — RRF stays the main signal.
# RAG_RECENCY_WEIGHT=0.25
# Half-life of the recency boost (days).
# After this many days the recency boost (RAG_RECENCY_WEIGHT) halves.
# RAG_RECENCY_HALF_LIFE_DAYS=180
# Maximum chunks from one meeting in the final top (diversification).
# The ceiling in retrieval.py diversifies the top — beyond it, chunks of the same meeting are dropped.
# RAG_MAX_PER_MEETING=3
# From how many query words the soft FTS relevance cutoff turns on (T6.8).
# Together with RAG_FTS_MIN_MATCHES it cuts from the FTS candidates the chunks with too few term matches.
# RAG_FTS_CUTOFF_MIN_WORDS=3
# Minimum real term matches for queries longer than the cutoff.
# Applies only when the query is longer than RAG_FTS_CUTOFF_MIN_WORDS words.
# RAG_FTS_MIN_MATCHES=2
# How many top candidates (by RRF+recency) to run through the cross-encoder rerank.
# Applies only when RECALL_RERANK_ENABLED=1 — the pool size before the rerank model.
# RAG_RERANK_POOL_SIZE=24
# Turns on the local cross-encoder rerank (bge-reranker-v2-m3) for the RAG chat (T6.4).
# Only for app/services/rag.py — not for copilot/categorize/MCP. The default is duplicated in config.py (documented, not eliminated — debt S4/S6).
# RECALL_RERANK_ENABLED=0
# HF model for the cross-encoder rerank.
# Applies only when RECALL_RERANK_ENABLED=1 — which HF model reranker.py loads.
# RECALL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Device for the reranker ('cuda'/'cpu'). Empty = autodetect.
# Empty — reranker.py takes cuda if torch.cuda.is_available(), otherwise cpu.
# RERANK_DEVICE=

# --- RAG retrieval — comments ---
# Multiplier of the comment boost relative to kind_weight (correction 1.0 … question 0.4).
# A strong tie-breaker, not a muffler — so that comments alone are not returned for any question.
# RAG_COMMENT_WEIGHT=0.6
# How many candidates to take from the separate comment index.
# Ceiling of the number of candidates from the comment index before merging with the main RRF.
# RAG_COMMENT_CANDIDATE_CAP=20
# Maximum share of the top that comments may occupy.
# Without a ceiling 30 planted comments took 115 slots out of 120 at k=8 (Wave 2.5).
# RAG_COMMENT_MAX_SHARE=0.34
# Maximum attached comments per answer.
# Default cap in the function that attaches comments to a finding — beyond it comments are dropped.
# RAG_ATTACH_COMMENT_CAP=8

# --- RAG retrieval — threads ---
# How many neighbours of the TG thread to stitch to a finding in the prompt.
# The answer is the next reply of the thread, it shares no words with the query.
# RAG_THREAD_STITCH=6
# Character ceiling per neighbouring message in the thread stitch.
# Applies to neighbours; the finding itself (the hit) is cut separately, to the remainder of RAG_THREAD_CHARS.
# RAG_THREAD_MSG_CHARS=1500
# Character ceiling for the whole thread stitch (all messages together).
# Without it one long thread (156k characters) crowded other sources out of the prompt.
# RAG_THREAD_CHARS=8000

# --- RAG retrieval — query rewriting ---
# Turns on 1-3 alternative query formulations (Claude) as additional vector+FTS subqueries merged by the same RRF.
# Off by default — turned on selectively for measurement by the gate (evals/gate.py calls retrieval.search without the flag → reads this env).
# RAG_QUERY_REWRITE=0
# Which Claude model generates the alternative query formulations.
# Applies only when RAG_QUERY_REWRITE=1 — a cheap auxiliary call before the main RAG query.
# RAG_QUERY_REWRITE_MODEL=claude-haiku-4-5-20251001

# --- Embeddings ---
# Embedding model (1024-dim, multilingual).
# bge-m3 rejected: it has no safetensors, conflicts with the torch<2.6 pin (CVE-2025-32434). The query/passage prefix style (e5/qwen3/plain) is determined by embeddings.py from the NAME of this model.
# EMBED_MODEL=intfloat/multilingual-e5-large
# Version of the embedding chunking/logic (T6.8) — a bump forces a re-embed of the archive.
# Changed ONLY in `.env` (ADR-016: the code default does not move with the live epoch). When the chunking format or prefix changes, take a number strictly higher than the pair held by the live DB (`SELECT embedding_model, embedding_version, COUNT(*) FROM transcriptions GROUP BY 1, 2`), and then run `reembed.run` — a number that already exists in the DB would leave the new format in the old epoch (stale_ids = 0). retrieval.search takes only chunks of the current pair (EMBED_MODEL, EMBED_VERSION) — vectors of another epoch are not compared.
# EMBED_VERSION=2
# Sequence length ceiling for the embedding model (in tokens).
# Works ONLY downward: e5 with its 512 is not touched. Needed for models without sentence_bert_config.json (Qwen3-Embedding): without a ceiling sentence-transformers takes 32768, monster chunks (documents/TG, up to 18k tokens) eat 17 GB of VRAM and the pass slows down 30 times. 0 = ceiling off.
# EMBED_MAX_SEQ=1024
# Device for embeddings ('cuda'/'cpu'). Empty = autodetect.
# Empty — embeddings.py takes cuda if torch.cuda.is_available(), otherwise cpu.
# EMBED_DEVICE=
# Threshold of the number of embedded chunks after which a WARNING about scale is logged (T6.6).
# Brute-force numpy vector search — a signal to plan the migration to ANN (sqlite-vec) in advance.
# RECALL_VECTOR_WARN_THRESHOLD=50000

# --- OCR / documents ---
# Tesseract language packs for document OCR.
# If a language pack is missing — pytesseract raises TesseractError, document_parser.py falls back to the default language (eng).
# OCR_LANG=ukr+rus+eng
# Path to tesseract.exe if it is not in PATH.
# Empty — PATH, and without it the standard installer path C:\Program Files\Tesseract-OCR\tesseract.exe.
# OCR_TESSERACT_CMD=
# Folder of Tesseract language packs (ukr/rus/eng).
# Empty — %LOCALAPPDATA%\Recall\tessdata, if the folder exists. Needed because in Program Files language packs cannot be added without administrator rights.
# OCR_TESSDATA_DIR=
# Fast language packs (tessdata_fast) for OCR of video frames.
# Empty — %LOCALAPPDATA%\Recall\tessdata_fast, if the folder exists; otherwise video OCR takes the regular packs. Documents always use the regular ones.
# OCR_TESSDATA_FAST_DIR=
# DPI of the PDF page render for OCR.
# Passed to page.get_pixmap(dpi=...) before OCR — a higher DPI improves quality at the cost of time.
# OCR_DPI=200
# Cap of synchronous OCR (pages).
# Beyond this number of pages document_parser.py no longer runs OCR for the document.
# OCR_MAX_PAGES=50
# List of absolute directories (separated by ';') allowed for import-folder.
# Empty → import-folder is forbidden everywhere (deny-by-default, T1.3).
# RECALL_IMPORT_ROOTS=
# Path to the SQLite DB for the standalone CLI run of app/services/comments.py.
# config.py keeps its own hardcode DATABASE='whisper_history.db' (a duplicate, non-goal 5 — not eliminated).
# DATABASE=whisper_history.db

# --- Claude API ---
# Anthropic key. Without it polish/enrichment/RAG chat/copilot verification/vision(claude) are off.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# Default model for text/RAG (single source of truth — app/services/models.py).
# default_model() in app/services/models.py returns this value if set — otherwise DEFAULT_MODEL from the code.
# CLAUDE_MODEL=claude-opus-5
# Hugging Face token for pyannote (diarization).
# Requires accepting the licenses of the models pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0.
# HF_TOKEN=

# --- Copilot ---
# Turns on the live call co-pilot (Phase 19).
# Degrades softly: no Ollama/model → is_available()=False, recording/STT/RAG work as before.
# COPILOT_ENABLED=1
# HTTP address of the local Ollama service.
# Base URL to which local_llm.py sends /api/generate and /api/tags to Ollama.
# LOCAL_LLM_URL=http://localhost:11434
# Local dispatcher model of the copilot.
# Default model for all local_llm calls (copilot, TG threads, chat dossier) if the call did not override it with its own.
# LOCAL_LLM_MODEL=qwen2.5:14b-instruct-q5_K_M
# Ollama keep_alive for the copilot model.
# The keep_alive value in the request to Ollama — how long to keep the model in GPU memory without unloading.
# LOCAL_LLM_KEEPALIVE=30m
# Context size of the local copilot model.
# The num_ctx value in the request to Ollama — prompts longer than this limit are truncated/degrade the model.
# LOCAL_LLM_NUM_CTX=8192
# Timeout of the local copilot model call (sec).
# Default HTTP request timeout of local_llm.py to Ollama if the call did not pass its own.
# LOCAL_LLM_TIMEOUT=60

# --- Record titles ---
# Local model that proposes a record's title and description (meta_suggest.py). Empty = LOCAL_LLM_MODEL.
# Measurement 14.10.2026 on #8677: MamayLM 12B ~40 s and three different topical variants; qwen2.5:7b in 10 s gave almost identical descriptions. During recording the model is not called at all (copilot).
# LOCAL_TITLE_MODEL=hf.co/INSAIT-Institute/MamayLM-Gemma-3-12B-IT-v2.0-GGUF:Q5_K_M
# Ollama keep_alive for the title model. 0 = unload right after the reply.
# Otherwise 12B holds VRAM for another 30 min (LOCAL_LLM_KEEPALIVE), and a call during that time leaves the copilot and transcription without room. Cost: every suggestion from a cold start (~45 s instead of ~15).
# LOCAL_TITLE_KEEPALIVE=0
# Timeout of one title and description suggestion (sec).
# The default 60 s of local_llm is too small: 12B on a cold start takes longer to load into VRAM.
# LOCAL_TITLE_TIMEOUT=180
# "Regular" Claude model for verifying what is important (local-first cascade).
# Read every time (not cached) in copilot/config.py — the model for the regular (not "gnarly") escalation to Claude.
# COPILOT_MODEL_API=claude-sonnet-5
# Arbiter model for the copilot's 'gnarly'/uncertain cases.
# Deliberately a DIFFERENT model from COPILOT_MODEL_API — do not collapse.
# COPILOT_MODEL_API_GNARLY=claude-opus-5
# Tick period of the copilot topic state machine (sec).
# Period of the _tick_sec loop in copilot/worker.py — how often the topic state is checked.
# COPILOT_TOPIC_TICK_SEC=6
# Minimum character window for evaluating a copilot topic.
# _min_window_chars in copilot/worker.py — while the transcript window is smaller, topic evaluation does not start.
# COPILOT_TOPIC_WINDOW_CHARS=200
# Claude spend ceiling per call (USD) for the "What I missed" live summary.
# The per-call ceiling of the summary button (wave4-client-calls); negative values are invalid. The button is not offered for agent recordings.
# LIVE_MISSED_BUDGET_USD=0.10

# --- Auth / access ---
# Safe default (Wave 0 / T1.1): listen only on the local machine. Going out to
# the whole network is a conscious opt-in: RECALL_BIND_ALL=1 or FLASK_HOST=0.0.0.0.
# A network bind requires an explicit SECRET_KEY (otherwise hard-fail) and, as a rule,
# RECALL_LOCAL_TRUSTED=0 + RECALL_API_KEY (see below).
# 1 → the SECRET_KEY default becomes a hard-fail (config.py), not an autogen.
# RECALL_BIND_ALL=
# Requests from localhost do not need a key while enabled.
# T1.2: turn off (0) if the application is reachable over the network and a key is needed even locally.
# profiles — desktop=1, headless=0
# RECALL_LOCAL_TRUSTED=1
# Access key for requests NOT from localhost (or RECALL_LOCAL_TRUSTED=0).
# Header X-Recall-Api-Key or Authorization: Bearer. Not set → fail-closed for non-localhost.
# RECALL_API_KEY=
# Tailnet IPs of devices allowed into Recall via tailscale serve (comma-separated). A device has TWO addresses — 100.x and fd7a:… (IPv6): enter both, serve passes the one the client came with.
# A localhost request with X-Forwarded-For/Tailscale-User-Login is proxied: without an IP here or a key → 401. Empty → nobody through the proxy (the vps-prod server in the same tailnet too).
# RECALL_PROXY_ALLOWED_IPS=

# --- MCP server ---
# Address of the live Flask (app.py) to which mcp_server.py proxies write/live/AI actions.
# The base API_URL in mcp_server.py — where all proxied HTTP requests to app.py go.
# RECALL_API_URL=http://127.0.0.1:5050
# Emergency switch for all MCP writes (does not affect reading).
# Off by default (empty). On: no write tool (mailbox, settings, video_analyze) is registered at all, whatever RECALL_MCP_PROFILE says.
# RECALL_MCP_READONLY=
# Which MCP tools mcp_server.py registers: full | read.
# full — every tool; read — the read tools plus video_analyze. An unknown value = read (one warning on stderr). Read at mcp_server.py start.
# RECALL_MCP_PROFILE=full
# Bearer key for the http transport of mcp_server.py.
# Needed ONLY for --transport http (listens on 127.0.0.1:5060); the default stdio needs no key.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# RECALL_MCP_KEY=
# 1/true → log every MCP tool call to logs/mcp_calls.log; or an explicit path.
# Off by default (zero overhead).
# RECALL_MCP_DEBUG_LOG=
# Port of the http transport of mcp_server.py.
# Applies only with --transport http; the default stdio transport does not use this port.
# MCP_PORT=5060
# What of the video visual timeline MCP gives to Claude: images | text | off.
# images — frames and on-screen text (through the stop list); text — text only, get_frame refuses; off — nothing visual, and screen chunks disappear from search/grep/ask_archive. An unknown value = off. The Recall UI is not affected.
# RECALL_MCP_VISUAL=images
# Directions/projects whose visual content does not go outside (names separated by commas).
# The name is matched at any level of the tree together with descendants; namesakes are all hidden. The same stop list — for MCP and the K4 bot.
# RECALL_PRIVATE_CATEGORIES=Юридичне,Особисте
# File of stop words/names (one per line, # — comment).
# Empty — private.txt in the project root (in .gitignore; example — private.example.txt). No file — no stop words; unreadable — the visual content is hidden.
# RECALL_PRIVATE_WORDS_FILE=

# --- Pipes ---
# Scheduled briefings (K4, app/services/pipes.py): the pipes/*.md files run by themselves.
# 1 → in the app.py process (under __main__) a daemon thread every 30 s runs the pipes whose moment has come, and once catches up on what was missed at startup. 0 → the thread does not start, one line in the log.
# PIPES_ENABLED=0
# After how many minutes to retry a pipe run that failed (data, bot, other failure).
# A failure does not close the schedule moment: the scheduler tries again until it delivers or exhausts PIPES_RETRY_MAX.
# PIPES_RETRY_MINUTES=15
# How many attempts per schedule moment (including the first).
# After this many errors the scheduler waits for the next moment; the bot receives "attempts exhausted". 6 attempts of 15 min — about an hour and a half after 9:00.
# PIPES_RETRY_MAX=6
# Delivery bot token from @BotFather (a separate bot, not the listener account).
# Without it (or without TELEGRAM_BOT_CHAT_ID) pipes send nothing — every run is written to the history with the error "bot not configured".
# TELEGRAM_BOT_TOKEN=
# The owner's chat to which the bot sends briefings: `python -m app.services.tg_bot whoami` after /start to the bot.
# The bot sends ONLY here; the code accepts no other recipients.
# TELEGRAM_BOT_CHAT_ID=
# Claude model that writes 1–2 lines of "the main thing" above the briefing card.
# If the cost estimate BEFORE the call is above the pipe's budget_usd, there is no key or an error → the same message without the "main thing" line.
# PIPES_MODEL=claude-sonnet-5
# Recall address visible from a phone (e.g. https://home-pc.<tailnet>.ts.net via tailscale serve).
# Base of links in the briefing cards in Telegram. Empty → RECALL_API_URL (open only on this PC).
# RECALL_PUBLIC_URL=

# --- Logging ---
# Turns on the RotatingFileHandler of the module logger 'whisper_ui'.
# Off by default — a second handler on the shared file blocked rollover on Windows (WinError 32).
# RECALL_LOG_TO_FILE=0
