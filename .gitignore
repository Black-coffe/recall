# Model update-check state (local, per-machine)
model_update_state.json

# evals: локальний golden-set і результати прогонів (реальні дані архіву — не комітити)
evals/*_rerank.json

# eval-gate: JSONL golden-set із реальних запитів/задач, базові лінії, знімки БД
evals/*.local.jsonl
evals/snapshots/

# eval-gate: --json-out гейта (реальні питання/transcription_id архіву) — конвенція
# приватності *.local.* у назві, яку сам gate.py вимагає (exit 2 без неї)
evals/*.local.json

# Робочі документи з конкретикою особистого архіву (гриль-брифи, плани треків):
# імена людей, назви проєктів, цифри використання. Лишаються локально.
docs/grill/
docs/plans/

# Локальна карта чат→напрямок (назви чатів і людей — не в публічний репозиторій)
data/*.local.json

# Результати прогонів eval (реальні питання і назви джерел архіву)
evals/after_*.json
evals/before_*.json

# Одноразові вивантаження з архіву (цитати з реальних дзвінків) — не комітити
_plans.txt

# Дампи стану сесій Claude Code (містять уривки робочого контексту)
.claude/handoff/

# --- VULYK runtime artifacts (added by install.sh; safe to reorder or annotate) ---
# Per-machine or derived. Committing any of them creates a second account of
# something the repository already holds, which is the failure mode the framework
# spends most of its checks preventing.
.claude/.vulyk-update-cache
.claude/settings.json.vulyk-bak
.claude/state.json
.claude/settings.local.json
CLAUDE.local.md
memory/snapshots/
memory/map/.stale

# --- VULYK runtime artifacts (added by install.sh; safe to reorder or annotate) ---
# Per-machine or derived. Committing any of them creates a second account of
# something the repository already holds, which is the failure mode the framework
# spends most of its checks preventing.
.vulyk/
docs/specs/*/PAUSE

# --- VULYK runtime artifacts (added by install.sh; safe to reorder or annotate) ---
# Per-machine or derived. Committing any of them creates a second account of
# something the repository already holds, which is the failure mode the framework
# spends most of its checks preventing.
docs/specs/*/DRIVER
