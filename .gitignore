# Google не потрапив у публічний репозиторій.
cookies.txt
.tmp_test_sse/
.tmp_screens/
.claude/scheduled_tasks.lock

# Phase 17: Telegram — сесія = ПОВНИЙ доступ до акаунта, медіа = особисті дані.
